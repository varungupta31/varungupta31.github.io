---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import DetectPhoto from "@/components/DetectPhoto.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// Posts
const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

const contactLinks: {
	friendlyName: string;
	link: string;
	name: string;
	title: string;
}[] = [
	{
		friendlyName: "LinkedIn",
		link: "https://www.linkedin.com/in/varungupta31/",
		name: "mdi:linkedin",
		title: "linkedin.com/in/varungupta31",
	},
	{
		friendlyName: "GitHub",
		link: "https://github.com/varungupta31",
		name: "mdi:github",
		title: "github.com/varungupta31",
	},
	{
		friendlyName: "Google Scholar",
		link: "https://scholar.google.com/citations?user=6Bc_428AAAAJ&hl=en",
		name: "simple-icons:googlescholar",
		title: "Publications & citations",
	},
	{
		friendlyName: "Email",
		link: "mailto:gupta.varun@research.iiit.ac.in",
		name: "mdi:email",
		title: "gupta.varun@research.iiit.ac.in",
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<section class="grid items-center gap-10 sm:grid-cols-[1fr_auto]">
		<div data-motion>
			<h1 class="title mb-6 text-5xl sm:text-6xl">Varun Gupta</h1>
			<div class="max-w-prose space-y-4">
				<p>
					I’m a research intern at{" "}
					<a
						class="cactus-link ms-colors inline-block"
						href="https://www.microsoft.com/en-us/research/lab/microsoft-research-india/"
						rel="noreferrer"
						target="_blank">Microsoft Research</a
					>, working with the Copilot team on agentic memory (helping AI agents remember things),
					advised by{" "}
					<a
						class="cactus-link inline-block"
						href="https://scholar.google.com/citations?user=QolzyE4AAAAJ&hl=en"
						rel="noreferrer"
						target="_blank">Akshay Nambi</a
					>.
				</p>
				<p>
					Before this, I did my Master’s at CVIT,{" "}
					<a class="cactus-link inline-block" href="https://www.iiit.ac.in/" rel="noreferrer" target="_blank"
						>IIIT Hyderabad</a
					> with{" "}
					<a class="cactus-link inline-block" href="https://makarandtapaswi.github.io/" rel="noreferrer" target="_blank"
						>Makarand Tapaswi</a
					>. I worked closely with{" "}
					<a
						class="cactus-link inline-block"
						href="https://scholar.google.com/citations?user=U9dH-DoAAAAJ&hl=en"
						rel="noreferrer"
						target="_blank">Prof. C.V. Jawahar</a
					> on the Indian Driving Dataset, where the traffic is wonderfully chaotic, and collaborate often
					with{" "}
					<a class="cactus-link inline-block" href="https://vineet-gandhi.github.io/" rel="noreferrer" target="_blank"
						>Prof. Vineet Gandhi</a
					> and{" "}
					<a
						class="cactus-link inline-block"
						href="https://scholar.google.com/citations?user=TmWYBeEAAAAJ"
						rel="noreferrer"
						target="_blank">Subhashini Venugopalan</a
					>.
				</p>
				<p>
					Lately I’ve been drawn to making agentic AI safe, reliable, and consistent. In parallel, I
					continue to work on giving models better vision by steering and interpreting foundation models,
					and building models that truly understand motion.
				</p>
				<p>
					Off the clock, you’ll find me cooking, biking around, vibing to music, taking photos, or lifting
					some weights!
				</p>
			</div>
		</div>
		<DetectPhoto
			src="/img/prof_pic.jpg"
			alt="Varun Gupta"
			width={619}
			height={675}
			perch
			transitionName="hero-photo"
			class="w-56 justify-self-center sm:w-64 lg:w-72"
			boxes={[
				{ label: "person", score: 0.98, x: 0, y: 3, w: 97, h: 97 },
				{ label: "glasses", score: 0.94, x: 21, y: 19, w: 49, h: 19 },
				{ label: "backpack", score: 0.81, x: 67, y: 45, w: 23, h: 36 },
				{ label: "hand", score: 0.88, x: 88, y: 66, w: 11, h: 17 },
				{ label: "text: “Portofino Lover”", score: 0.86, x: 46, y: 76, w: 40, h: 22 },
				{ label: "bench", score: 0.77, x: 88, y: 70, w: 12, h: 29, labelAt: "inside-bottom" },
			]}
		/>
	</section>
	<section class="mt-20">
		<h2 class="title text-accent mb-8 text-xl" data-motion>Find me on</h2>
		<ul class="grid grid-cols-2 gap-x-6 gap-y-2 sm:flex sm:justify-between" role="list">
			{
				contactLinks.map(({ friendlyName, link, name, title }) => {
					const isMail = link.startsWith("mailto:");
					return (
						<li data-motion>
							<a
								class="group hover:text-accent focus-visible:outline-accent flex items-center gap-3 rounded-sm py-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
								href={link}
								rel={isMail ? undefined : "noreferrer"}
								target={isMail ? undefined : "_blank"}
								title={title}
							>
								<Icon
									aria-hidden="true"
									class="h-7 w-7 shrink-0 transition-transform group-hover:scale-110"
									name={name}
								/>
								<span class="font-semibold sm:whitespace-nowrap">{friendlyName}</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Pinned Posts</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	{
		latestPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">Posts</a></h2>
				<ul class="space-y-4" role="list">
					{
						latestPosts.map((p) => (
							<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
								<PostPreview post={p} />
							</li>
						))
					}
				</ul>
			</section>
		)
	}
</PageLayout>