---
// The site's cat: a pixel cat that lives on the bottom edge of the window. It wanders, sits and
// grooms, naps when it has been awake a while, chases the cursor when it comes down to its level,
// and jumps up onto elements marked data-cat-perch (the photos) to sit, stroll and nap there.
// In dark mode it becomes a black silhouette with only its eyes showing.
// Sprites: "Pixel Cats" by Last tick, decrypted into /cat/ at build time (scripts/cat-assets.mjs).
// Without them the cat stays hidden. Purely decorative: only its body takes clicks.
---

<div id="site-cat" class="site-cat" aria-hidden="true" hidden>
	<div class="cat-sprite"></div>
	<div class="cat-hit"></div>
</div>

<style>
	/* sizes are set from the script, which picks the sprite scale for the screen */
	.site-cat {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 30;
		pointer-events: none;
		will-change: transform;
	}
	.cat-sprite {
		width: 100%;
		height: 100%;
		background: url("/cat/black.png") 0 0 no-repeat;
		image-rendering: pixelated;
	}
	.cat-hit {
		position: absolute;
		pointer-events: auto;
		cursor: pointer;
	}
</style>

<script>
	type Anim = { row: number; col?: number; frames?: number; fps?: number; dy?: number };
	type Dir = "L" | "R";
	type Gait = "walk" | "run";
	type Point = { sx: number; fy: number }; // screen x of the cell's left edge, screen y of the feet

	const SHEET_W = 896;
	const SHEET_H = 4608;

	// Rows of the 64x64 sheet. dy lowers poses whose artwork sits higher in the cell, so every pose
	// rests on the same ground line.
	const A = {
		sitF: { row: 0, col: 0 },
		sitL: { row: 0, col: 2 },
		sitR: { row: 0, col: 3 },
		standL: { row: 1, col: 2 },
		standR: { row: 1, col: 3 },
		lieL: { row: 7, col: 1, dy: 3 },
		lieR: { row: 7, col: 2, dy: 3 },
		walkL: { row: 4, frames: 6, fps: 9 },
		walkR: { row: 5, frames: 6, fps: 9 },
		runR: { row: 10, frames: 5, fps: 12 },
		runL: { row: 11, frames: 5, fps: 12 },
		lickSit: { row: 12, frames: 8, fps: 8 },
		meowSit: { row: 14, frames: 3, fps: 6 },
		scratchL: { row: 17, frames: 8, fps: 10 },
		scratchR: { row: 18, frames: 8, fps: 10 },
		tailSitL: { row: 21, frames: 5, fps: 6 },
		tailSitR: { row: 22, frames: 5, fps: 6 },
		tailStandL: { row: 25, frames: 5, fps: 6 },
		tailStandR: { row: 26, frames: 5, fps: 6 },
		tailLieL: { row: 27, frames: 3, fps: 4, dy: 1 },
		tailLieR: { row: 28, frames: 3, fps: 4, dy: 2 },
		swipeL: { row: 32, frames: 11, fps: 14 },
		swipeR: { row: 35, frames: 11, fps: 14 },
		yawn: { row: 43, frames: 7, fps: 7 },
		sleepLoafL: { row: 44, frames: 2, fps: 0.8, dy: 2 },
		sleepLoafR: { row: 45, frames: 2, fps: 0.8, dy: 2 },
		sleepCurlL: { row: 48, frames: 2, fps: 0.7, dy: 6 },
		sleepCurlR: { row: 49, frames: 2, fps: 0.7, dy: 6 },
		sleepCurl2L: { row: 50, frames: 2, fps: 0.7, dy: 6 },
		sleepCurl2R: { row: 51, frames: 2, fps: 0.7, dy: 6 },
		jumpL: { row: 63, frames: 5, fps: 10 },
		jumpR: { row: 64, frames: 5, fps: 10 },
		jumpCrouchL: { row: 63, col: 0, frames: 2, fps: 9 },
		jumpCrouchR: { row: 64, col: 0, frames: 2, fps: 9 },
		jumpAirL: { row: 63, col: 2 },
		jumpAirR: { row: 64, col: 2 },
		jumpLandL: { row: 63, col: 3, frames: 2, fps: 9 },
		jumpLandR: { row: 64, col: 3, frames: 2, fps: 9 },
		hind: { row: 65, frames: 4, fps: 6 },
	} satisfies Record<string, Anim>;
	type Sided = { [K in keyof typeof A]: K extends `${infer B}L` ? B : never }[keyof typeof A];

	const el = document.getElementById("site-cat");
	if (el) start(el);

	function start(root: HTMLElement) {
		const sprite = root.querySelector<HTMLElement>(".cat-sprite")!;
		const hit = root.querySelector<HTMLElement>(".cat-hit")!;
		const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
		const finePointer = matchMedia("(pointer: fine)").matches;
		const rand = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
		const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

		// sprite scale: 64px cells drawn at 2.5x, or 2x on phones
		const S = matchMedia("(max-width: 640px)").matches ? 2 : 2.5;
		const CELL = 64 * S;
		const FEET = 48 * S; // the feet rest on row 47 of a cell
		const BODY_L = 12 * S; // the drawn body spans x 12..54 of a cell
		const BODY_R = 54 * S;
		const MID = 33 * S;
		const WALK_SPEED = 2.4 * 9 * S; // px/s, matched to the paws in the 9fps walk cycle
		const RUN_SPEED = 6 * 12 * S;
		root.style.width = root.style.height = `${CELL}px`;
		sprite.style.backgroundSize = `${SHEET_W * S}px ${SHEET_H * S}px`;
		Object.assign(hit.style, { left: `${14 * S}px`, top: `${17 * S}px`, width: `${36 * S}px`, height: `${31 * S}px` });

		// --- where the cat is: on the floor (the window's bottom edge) or on top of a perch element.
		// x is the cell's left edge relative to that surface.
		let surface: HTMLElement | null = null;
		let x = 0;
		let air: { from: Point; to: () => Point; t0: number; dur: number; h: number; done: () => void } | null = null;
		let facing: Dir = "R";
		let anim: Anim = A.sitR;
		let animT0 = performance.now();
		let animCycles = 0; // 0 loops forever; otherwise hold the last frame after this many cycles
		let animDone: (() => void) | null = null;
		let move: { target: () => number; gait: Gait; abort?: () => boolean; done: () => void } | null = null;
		let asleep = false;
		let awakeSince = performance.now();

		const side = (name: Sided) => A[`${name}${facing}` as keyof typeof A];
		const floorY = () => window.innerHeight - 6;
		function bounds(): [number, number] {
			if (!surface) return [12 - BODY_L, Math.max(12 - BODY_L, window.innerWidth - 12 - BODY_R)];
			const w = surface.getBoundingClientRect().width;
			const lo = 2 * S - BODY_L;
			const hi = w - 2 * S - BODY_R;
			return hi < lo ? [(lo + hi) / 2, (lo + hi) / 2] : [lo, hi];
		}
		const clamp = (v: number) => {
			const [lo, hi] = bounds();
			return Math.min(hi, Math.max(lo, v));
		};
		const here = (): Point => {
			if (!surface) return { sx: x, fy: floorY() };
			const r = surface.getBoundingClientRect();
			return { sx: r.left + x, fy: r.top };
		};
		const center = () => here().sx + MID;

		// --- interruptions: an interaction bumps the epoch, and every pending wait of the
		// behaviour it replaces resolves false so that behaviour stops where it is
		let epoch = 0;
		const pending = new Set<() => void>();
		function interrupt() {
			epoch++;
			if (move) {
				const done = move.done;
				move = null;
				done();
			}
			for (const finish of [...pending]) finish();
		}
		function delay(ms: number): Promise<boolean> {
			const e = epoch;
			return new Promise((resolve) => {
				const finish = () => {
					clearTimeout(id);
					pending.delete(finish);
					resolve(e === epoch);
				};
				const id = setTimeout(finish, ms);
				pending.add(finish);
			});
		}

		function play(a: Anim) {
			const done = animDone;
			animDone = null;
			anim = a;
			animT0 = performance.now();
			animCycles = 0;
			done?.();
		}
		function playOnce(a: Anim, cycles = 1): Promise<boolean> {
			const e = epoch;
			play(a);
			animCycles = cycles;
			return new Promise((resolve) => {
				animDone = () => resolve(e === epoch);
			});
		}
		function moveTo(target: () => number, gait: Gait, abort?: () => boolean): Promise<boolean> {
			const e = epoch;
			return new Promise((resolve) => {
				const t = clamp(target());
				if (Math.abs(t - x) < 2) return resolve(e === epoch);
				facing = t < x ? "L" : "R";
				play(gait === "run" ? side("run") : side("walk"));
				move = { target, gait, abort, done: () => resolve(e === epoch) };
			});
		}
		// a jump arc from where the cat is to a point that may move (the page can scroll mid-air);
		// it always finishes, even when interrupted, so the cat never stops in the air
		function jump(to: () => Point): Promise<boolean> {
			const e = epoch;
			const from = here();
			const t = to();
			const rise = Math.max(0, from.fy - t.fy);
			const dist = Math.hypot(t.sx - from.sx, t.fy - from.fy);
			return new Promise((resolve) => {
				air = {
					from,
					to,
					t0: performance.now(),
					dur: 360 + Math.sqrt(dist) * 17,
					h: 14 * S + rise * 0.12,
					done: () => resolve(e === epoch),
				};
			});
		}

		// --- one loop draws the frame and moves the cat, so the feet and the ground stay in step
		let last = performance.now();
		function render(now: number) {
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			if (move) {
				const t = clamp(move.target());
				const d = t - x;
				const step = (move.gait === "run" ? RUN_SPEED : WALK_SPEED) * dt;
				if (Math.abs(d) <= step + 0.5 || move.abort?.()) {
					if (Math.abs(d) <= step + 0.5) x = t;
					const done = move.done;
					move = null;
					done();
				} else {
					const dir: Dir = d < 0 ? "L" : "R";
					if (dir !== facing) {
						facing = dir;
						play(move.gait === "run" ? side("run") : side("walk"));
					}
					x += Math.sign(d) * step;
				}
			}
			let p = here();
			if (air) {
				const t = Math.min(1, (now - air.t0) / air.dur);
				const to = air.to();
				p = {
					sx: lerp(air.from.sx, to.sx, t),
					fy: lerp(air.from.fy, to.fy, t) - air.h * 4 * t * (1 - t),
				};
				if (t >= 1) {
					const done = air.done;
					air = null;
					done();
				}
			}
			const frames = anim.frames ?? 1;
			let i = Math.floor(((now - animT0) / 1000) * (anim.fps ?? 1));
			if (animCycles && i >= frames * animCycles) {
				i = frames - 1;
				const done = animDone;
				animDone = null;
				done?.();
			} else i %= frames;
			sprite.style.backgroundPosition = `${-((anim.col ?? 0) + i) * CELL}px ${-anim.row * CELL}px`;
			const dpr = window.devicePixelRatio || 1;
			const snap = (v: number) => Math.round(v * dpr) / dpr;
			root.style.transform = `translate3d(${snap(p.sx)}px, ${snap(p.fy - FEET + (anim.dy ?? 0) * S)}px, 0)`;
		}
		function loop(now: number) {
			render(now);
			requestAnimationFrame(loop);
		}

		// --- what the cat does on its own (on the floor or on a perch: moves stay inside the surface)
		async function wander() {
			const [lo, hi] = bounds();
			const minStep = Math.min(140, (hi - lo) / 3);
			let t = rand(lo, hi);
			if (Math.abs(t - x) < minStep) t = clamp(x + (x > (lo + hi) / 2 ? -1 : 1) * rand(minStep, minStep + 200));
			const gait: Gait = !surface && Math.random() < 0.1 && Math.abs(t - x) > 400 ? "run" : "walk";
			if (!(await moveTo(() => t, gait))) return false;
			play(side("stand"));
			return delay(rand(350, 900));
		}
		async function sitAndWag() {
			play(side("sit"));
			if (!(await delay(rand(600, 1400)))) return false;
			play(side("tailSit"));
			return delay(rand(2500, 6500));
		}
		async function groom() {
			play(A.sitF);
			if (!(await delay(500))) return false;
			if (!(await playOnce(A.lickSit, 2 + Math.floor(Math.random() * 2)))) return false;
			play(A.sitF);
			return delay(rand(800, 1600));
		}
		async function scratch() {
			play(side("sit"));
			if (!(await delay(400))) return false;
			if (!(await playOnce(side("scratch"), 2))) return false;
			play(side("sit"));
			return delay(rand(600, 1200));
		}
		async function lookAround() {
			play(side("tailStand"));
			if (!(await delay(rand(1200, 2400)))) return false;
			facing = facing === "L" ? "R" : "L";
			play(side("tailStand"));
			return delay(rand(1000, 2000));
		}
		async function sleep(ms: number) {
			asleep = true;
			play(side("sleepLoaf"));
			if (!(await delay(rand(3000, 5000)))) return false;
			play(Math.random() < 0.5 ? side("sleepCurl") : side("sleepCurl2"));
			if (!(await delay(ms))) return false;
			play(side("sleepLoaf"));
			if (!(await delay(1500))) return false;
			asleep = false;
			awakeSince = performance.now();
			play(side("tailLie"));
			if (!(await delay(rand(1500, 2500)))) return false;
			play(side("sit"));
			return delay(800);
		}
		async function nap(sleepMs = rand(20000, 45000)) {
			play(A.sitF);
			if (!(await delay(600))) return false;
			if (!(await playOnce(A.yawn))) return false;
			play(A.sitF);
			if (!(await delay(500))) return false;
			play(side("lie"));
			if (!(await delay(1600))) return false;
			return sleep(sleepMs);
		}

		// --- perches: jump up onto an element, spend a short while there, jump back down.
		// Visits are kept short and spaced out so the cat spends most of its time on the ground.
		const PERCH_STAY: [number, number] = [12000, 25000];
		const PERCH_GAP = 35000; // at least this long on the ground between visits
		const perches = () => [...document.querySelectorAll<HTMLElement>("[data-cat-perch]")];
		function perchUsable(p: HTMLElement) {
			const r = p.getBoundingClientRect();
			// room above it for the cat, and the floor clearly below it
			return r.width > 60 * S && r.top > 40 * S && r.top < window.innerHeight - 140;
		}
		function perchOnScreen(p: HTMLElement) {
			const r = p.getBoundingClientRect();
			return r.top > 0 && r.top < window.innerHeight;
		}
		let lastPerch = -PERCH_GAP;
		let perchUntil = 0; // when the current visit ends, however often it is interrupted
		// the floor spot (cell left) from which the cat jumps onto a perch, beside its left or right end
		function launchX(p: HTMLElement, fromLeft: boolean) {
			const pr = p.getBoundingClientRect();
			return (fromLeft ? pr.left - 34 * S : pr.right + 34 * S) - MID;
		}
		async function visitPerch(p: HTMLElement, stay = PERCH_STAY, sizeUp: [number, number] = [500, 1100]) {
			lastPerch = performance.now();
			const r = p.getBoundingClientRect();
			const fromLeft = center() < r.left + r.width / 2;
			// walk to just beside it, then size it up
			const launch = () => launchX(p, fromLeft);
			if (!(await moveTo(launch, "walk"))) return false;
			facing = fromLeft ? "R" : "L";
			play(side("stand"));
			if (!(await delay(rand(...sizeUp)))) return false;
			if (!perchUsable(p)) return false;
			if (!(await playOnce(side("jumpCrouch")))) return false;
			play(side("jumpAir"));
			const w = p.getBoundingClientRect().width;
			const landX = fromLeft ? 4 * S - BODY_L : w - 4 * S - BODY_R;
			const ok = await jump(() => {
				const pr = p.getBoundingClientRect();
				return { sx: pr.left + landX, fy: pr.top };
			});
			surface = p;
			x = clamp(landX);
			perchUntil = performance.now() + rand(...stay);
			if (!(await playOnce(side("jumpLand"))) || !ok) return false;
			return perchLife(p);
		}
		async function perchLife(p: HTMLElement) {
			let hiddenSince = 0;
			while (performance.now() < perchUntil) {
				if (!perchOnScreen(p)) {
					hiddenSince ||= performance.now();
					if (performance.now() - hiddenSince > 4000) return backToFloor();
					if (!(await delay(500))) return false;
					continue;
				}
				hiddenSince = 0;
				const r = Math.random();
				// only a short doze up here, and only when there's time for one
				const left = perchUntil - performance.now();
				const napChance = left > 15000 && (performance.now() - awakeSince) / 1000 > 45 ? 0.1 : 0;
				let ok: boolean;
				if (r < napChance) ok = await nap(rand(6000, 10000));
				else if (r < napChance + 0.35) ok = await sitAndWag();
				else if (r < napChance + 0.6) ok = (await wander()) && (await sitAndWag());
				else if (r < napChance + 0.8) ok = await groom();
				else ok = await lookAround();
				if (!ok) return false;
			}
			return perchOnScreen(p) ? jumpDown() : backToFloor();
		}
		async function jumpDown() {
			const [lo, hi] = bounds();
			facing = x < (lo + hi) / 2 ? "L" : "R";
			if (!(await moveTo(() => (facing === "L" ? lo : hi), "walk"))) return false;
			if (!(await playOnce(side("jumpCrouch")))) return false;
			play(side("jumpAir"));
			const out = here().sx + (facing === "L" ? -40 * S : 40 * S);
			const landX = Math.min(window.innerWidth - 12 - BODY_R, Math.max(12 - BODY_L, out));
			const ok = await jump(() => ({ sx: landX, fy: floorY() }));
			surface = null;
			x = landX;
			lastPerch = performance.now();
			if (!(await playOnce(side("jumpLand"))) || !ok) return false;
			play(side("stand"));
			return delay(rand(300, 700));
		}
		// the perch scrolled away with the cat on it: it wanders back in from the side
		async function backToFloor() {
			surface = null;
			lastPerch = performance.now();
			const fromLeft = Math.random() < 0.5;
			x = fromLeft ? -CELL : window.innerWidth;
			return moveTo(() => rand(60, window.innerWidth - 60 - CELL), "walk");
		}
		// the opening hook on a page with a perch on screen (the photo): the cat sits on the ground for
		// a few seconds, walks over and jumps up, stays a few seconds, then hops down and is free
		async function welcome(p: HTMLElement) {
			play(side("sit"));
			if (!(await delay(rand(1300, 1600)))) return;
			play(side("tailSit"));
			if (!(await delay(rand(500, 700)))) return;
			if (!(await visitPerch(p, [5000, 7000], [300, 450]))) return;
		}

		let busy = false;
		async function life() {
			for (;;) {
				while (busy || document.hidden) await delay(400);
				if (surface) {
					// a perch visit that was interrupted (by a pat or a swipe) carries on up there
					await perchLife(surface);
					continue;
				}
				const awakeFor = (performance.now() - awakeSince) / 1000;
				const napChance = awakeFor > 75 ? 0.3 : 0.03;
				const perch =
					performance.now() - lastPerch > PERCH_GAP ? perches().find(perchUsable) : undefined;
				const r = Math.random();
				if (perch && r < 0.25) await visitPerch(perch);
				else if (r < napChance) await nap();
				else if (r < napChance + 0.4) (await wander()) && (await sitAndWag());
				else if (r < napChance + 0.58) await sitAndWag();
				else if (r < napChance + 0.72) await groom();
				else if (r < napChance + 0.8) await scratch();
				else await lookAround();
			}
		}

		// --- what the visitor can do with it
		let interaction = 0;
		async function interact(fn: () => Promise<unknown>) {
			const mine = ++interaction;
			busy = true;
			interrupt();
			await fn();
			if (mine === interaction) busy = false;
		}

		let px = -1;
		let py = -1;
		let lastMove = 0;
		let lastChase = 0;
		const recent = () => performance.now() - lastMove < 2500;
		const cursorLow = () => py > window.innerHeight - 320 && recent();

		async function chase() {
			facing = px < center() ? "L" : "R";
			play(side("tailStand")); // it notices first
			if (!(await delay(180))) return;
			const started = performance.now();
			while (cursorLow() && performance.now() - started < 12000) {
				const gait: Gait = Math.abs(px - center()) > 160 ? "run" : "walk";
				const reach = () => px - MID - (px >= center() ? 18 * S : -18 * S);
				const arrived = await moveTo(reach, gait, () => !cursorLow() || (gait === "walk" && Math.abs(px - center()) > 220));
				if (!arrived) return;
				if (!cursorLow()) break;
				if (Math.abs(px - center()) > 40 * S) continue;
				facing = px < center() ? "L" : "R";
				if (!(await playOnce(side("swipe")))) return;
				play(side("stand"));
				if (!(await delay(250))) return;
			}
			play(side("sit"));
			if (!(await delay(400))) return;
			play(side("tailSit"));
			await delay(rand(1500, 2500));
		}
		// up on a perch it can't run after the cursor, but it swats at it when it comes close
		async function perchSwipe() {
			facing = px < center() ? "L" : "R";
			play(side("stand"));
			if (!(await delay(120))) return;
			if (!(await playOnce(side("swipe")))) return;
			play(side("sit"));
			await delay(rand(800, 1400));
		}

		async function petted() {
			if (asleep) {
				asleep = false;
				awakeSince = performance.now();
				play(side("sleepLoaf"));
				if (!(await delay(500))) return;
				play(side("lie"));
				if (!(await delay(700))) return;
			}
			const r = Math.random();
			if (r < 0.5) {
				play(A.sitF);
				if (!(await delay(250))) return;
				if (!(await playOnce(A.meowSit, 2))) return;
				play(A.sitF);
				await delay(1500);
			} else if (r < 0.8) {
				if (!(await playOnce(side("jump")))) return;
				play(side("stand"));
				await delay(800);
			} else {
				if (!(await playOnce(A.hind, 2))) return;
				play(A.sitF);
				await delay(1200);
			}
		}

		// --- dark mode: the same cat as a black silhouette, only its eyes showing. The night sheet is
		// drawn once from the day sheet: every pixel goes near-black except the eyes' light glints.
		let nightUrl: string | null = null;
		function makeNightSheet(img: HTMLImageElement) {
			const c = document.createElement("canvas");
			c.width = img.naturalWidth;
			c.height = img.naturalHeight;
			const g = c.getContext("2d", { willReadFrequently: true });
			if (!g) return null;
			g.drawImage(img, 0, 0);
			const d = g.getImageData(0, 0, c.width, c.height);
			const p = d.data;
			const eyes: number[] = [];
			const isOutline = (i: number) => p[i + 3] && p[i] === 0x12 && p[i + 1] === 0x0e && p[i + 2] === 0x14;
			const row = c.width * 4;
			for (let i = 0; i < p.length; i += 4) {
				if (p[i + 3] && p[i] === 0xd3 && p[i + 1] === 0xdf && p[i + 2] === 0xe1) {
					// an eye is its light glint plus the dark pupil pixels around it: light them all
					eyes.push(i);
					for (const n of [i - 4, i + 4, i + row]) if (isOutline(n)) eyes.push(n);
				}
			}
			for (let i = 0; i < p.length; i += 4) {
				if (p[i + 3]) {
					p[i] = 10;
					p[i + 1] = 9;
					p[i + 2] = 11;
				}
			}
			for (const i of eyes) {
				p[i] = 0xf4;
				p[i + 1] = 0xe2;
				p[i + 2] = 0x7a;
				p[i + 3] = 255;
			}
			g.putImageData(d, 0, 0);
			return c.toDataURL("image/png");
		}
		function applyTheme(img: HTMLImageElement) {
			const dark = document.documentElement.getAttribute("data-theme") === "dark";
			if (dark && !nightUrl) nightUrl = makeNightSheet(img);
			sprite.style.backgroundImage = dark && nightUrl ? `url("${nightUrl}")` : "";
		}

		// --- carry the cat across page loads so it doesn't teleport
		const KEY = "site-cat";
		function save() {
			try {
				const onFloor = !surface && !air;
				sessionStorage.setItem(
					KEY,
					JSON.stringify({ x: here().sx, facing, asleep: asleep && onFloor, t: Date.now() }),
				);
			} catch {}
		}
		let resumeAsleep = false;
		try {
			const saved = JSON.parse(sessionStorage.getItem(KEY) ?? "null");
			if (saved && Date.now() - saved.t < 30 * 60 * 1000) {
				x = clamp(saved.x);
				facing = saved.facing === "L" ? "L" : "R";
				resumeAsleep = Boolean(saved.asleep);
			} else x = rand(...bounds());
		} catch {
			x = rand(...bounds());
		}

		const img = new Image();
		img.onload = () => {
			applyTheme(img);
			new MutationObserver(() => applyTheme(img)).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});
			// the opening hook: start on the ground just beside the photo, facing it
			const hookPerch = reduce ? undefined : perches().find(perchUsable);
			if (hookPerch) {
				const [lo, hi] = bounds();
				const r = hookPerch.getBoundingClientRect();
				// approach from whichever side has room on the floor; the left one when both do
				const fromLeft = launchX(hookPerch, true) >= lo || launchX(hookPerch, false) > hi;
				x = clamp(launchX(hookPerch, fromLeft) + (fromLeft ? -1 : 1) * rand(45, 70));
				facing = x + MID < r.left + r.width / 2 ? "R" : "L";
				resumeAsleep = false;
			}
			root.hidden = false;
			if (reduce) {
				// a calm cat: sitting still at the right-hand side
				x = bounds()[1];
				play(A.sitL);
				render(performance.now());
				return;
			}
			play(side("sit"));
			requestAnimationFrame(loop);
			addEventListener("pagehide", save);
			addEventListener("resize", () => (x = clamp(x)), { passive: true });
			hit.addEventListener("click", () => {
				if (!air) interact(petted);
			});
			if (finePointer) {
				addEventListener(
					"pointermove",
					(ev) => {
						if (ev.pointerType !== "mouse") return;
						px = ev.clientX;
						py = ev.clientY;
						lastMove = performance.now();
					},
					{ passive: true },
				);
				setInterval(() => {
					if (busy || asleep || air || document.hidden || !recent()) return;
					if (performance.now() - lastChase < 2500) return;
					if (surface) {
						const head = here().fy - 20 * S;
						if (Math.hypot(px - center(), py - head) > 34 * S) return;
						lastChase = performance.now();
						interact(perchSwipe);
						return;
					}
					if (!cursorLow() || Math.abs(px - center()) < 70) return;
					lastChase = performance.now();
					interact(chase);
				}, 120);
			}
			if (hookPerch) {
				interact(() => welcome(hookPerch));
			} else if (resumeAsleep) {
				play(side("sleepCurl"));
				interact(() => sleep(rand(8000, 20000)));
			}
			life();
		};
		img.src = "/cat/black.png";
	}
</script>
